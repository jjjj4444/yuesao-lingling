page {
  min-height: 100%;
  background: #eef2f3;
  color: #14213d;
}

.resume-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 150rpx;
  box-sizing: border-box;
}

.hero {
  min-height: 520rpx;
  padding: 34rpx 36rpx 38rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  background: linear-gradient(145deg, #102a43 0%, #1f6f78 48%, #f6c85f 100%);
  color: #ffffff;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-shadow: 0 24rpx 56rpx rgba(16, 42, 67, 0.22);
}

.hero-top,
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-top {
  justify-content: flex-end;
}

.profile-photo {
  width: 264rpx;
  height: 264rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.72);
  background: rgba(255, 255, 255, 0.18);
  box-shadow: 0 10rpx 24rpx rgba(20, 33, 61, 0.2);
}

.hero-name {
  margin-top: 34rpx;
  font-size: 68rpx;
  line-height: 1.08;
  font-weight: 800;
}

.hero-role {
  margin-top: 18rpx;
  font-size: 32rpx;
  line-height: 1.4;
  color: rgba(255, 255, 255, 0.88);
}

.hero-summary {
  margin-top: 32rpx;
  font-size: 28rpx;
  line-height: 1.75;
  color: rgba(255, 255, 255, 0.9);
}

.hero-tags,
.project-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.hero-tags {
  margin-top: 36rpx;
}

.tag,
.project-tag {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  line-height: 1.2;
}

.tag {
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
}

.info-panel,
.section {
  margin-top: 28rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 34rpx rgba(20, 33, 61, 0.08);
}

.info-panel {
  overflow: hidden;
}

.contact-actions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
}

.contact-action {
  min-height: 88rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.contact-action + .contact-action {
  border-left: 1rpx solid rgba(255, 255, 255, 0.18);
}

.phone-action {
  background: #14213d;
}

.wechat-action {
  background: #07c160;
}

.action-value {
  font-size: 27rpx;
  line-height: 1.2;
  font-weight: 800;
  text-align: center;
}

.info-group {
  padding: 24rpx;
  border-top: 1rpx solid #edf0f2;
  box-sizing: border-box;
}

.work-group {
  background: #fbfcfd;
}

.info-group-title {
  color: #1f6f78;
  font-size: 24rpx;
  line-height: 1.3;
  font-weight: 800;
}

.info-grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.info-item {
  padding: 20rpx;
  border-radius: 8rpx;
  background: #f7f9fa;
  box-sizing: border-box;
}

.work-grid .info-item {
  background: #ffffff;
  border: 1rpx solid #e6ebef;
}

.info-label,
.section-kicker,
.project-type {
  color: #6d7f8f;
  font-size: 22rpx;
  text-transform: uppercase;
}

.info-value {
  margin-top: 10rpx;
  color: #14213d;
  font-size: 26rpx;
  line-height: 1.35;
  word-break: break-all;
}

.section {
  padding: 34rpx 28rpx;
}

.section-title {
  margin-top: 6rpx;
  font-size: 36rpx;
  line-height: 1.25;
  font-weight: 800;
}

.project-card {
  border: 1rpx solid #e6ebef;
  border-radius: 8rpx;
  background: #fbfcfd;
}

.project-desc {
  color: #52616f;
  font-size: 26rpx;
  line-height: 1.68;
}

.project-list {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.project-body {
  padding: 26rpx;
}

.project-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.project-index {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #edf6f7;
  color: #1f6f78;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  line-height: 1;
  font-weight: 800;
}

.project-title {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 800;
}

.project-type {
  flex: 0 0 auto;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  background: #f4f6f8;
  color: #7a8694;
  font-size: 20rpx;
  line-height: 1.2;
}

.project-desc {
  margin-top: 14rpx;
}

.project-tags {
  margin-top: 20rpx;
}

.project-tag {
  background: #edf6f7;
  color: #1f6f78;
}

.project-link {
  margin-top: 18rpx;
  color: #1f6f78;
  font-size: 25rpx;
  font-weight: 800;
}

.certificate-list {
  margin-top: 26rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.certificate-card {
  padding: 24rpx;
  border: 1rpx solid #e6ebef;
  border-radius: 8rpx;
  background: #fbfcfd;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.certificate-main {
  flex: 1;
  min-width: 0;
}

.certificate-title {
  color: #14213d;
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 800;
}

.certificate-meta {
  margin-top: 10rpx;
  color: #52616f;
  font-size: 24rpx;
  line-height: 1.5;
}

.certificate-more {
  flex: 0 0 auto;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #edf6f7;
  color: #1f6f78;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 800;
}

.review-list {
  margin-top: 26rpx;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.review-card {
  padding: 24rpx;
  border: 1rpx solid #e6ebef;
  border-radius: 8rpx;
  background: #fbfcfd;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.review-main {
  flex: 1;
  min-width: 0;
}

.review-title {
  color: #14213d;
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 800;
}

.review-desc {
  margin-top: 10rpx;
  color: #52616f;
  font-size: 24rpx;
  line-height: 1.5;
}

.review-more {
  flex: 0 0 auto;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #edf6f7;
  color: #1f6f78;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 800;
}

.certificate-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 99;
  background: rgba(20, 33, 61, 0.46);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.certificate-sheet {
  position: relative;
  width: 100%;
  max-width: 660rpx;
  max-height: 78vh;
  padding: 34rpx 30rpx 36rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-sizing: border-box;
  overflow-y: auto;
}

.certificate-close {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #f4f6f8;
  color: #a8b0b8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  line-height: 1;
}

.certificate-modal-title {
  padding-right: 62rpx;
  color: #14213d;
  font-size: 36rpx;
  line-height: 1.25;
  font-weight: 800;
}

.certificate-image {
  width: 100%;
  margin-top: 24rpx;
  border-radius: 8rpx;
  background: #eef2f3;
}

.certificate-detail-list {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.certificate-detail-item {
  padding: 18rpx 20rpx;
  border-radius: 8rpx;
  background: #f7f9fa;
}

.certificate-detail-label {
  color: #1f6f78;
  font-size: 22rpx;
  line-height: 1.3;
  font-weight: 800;
}

.certificate-detail-value {
  margin-top: 8rpx;
  color: #52616f;
  font-size: 26rpx;
  line-height: 1.6;
}
