@import "../shared-tab.wxss";

.daily-card {
  margin-top: 22rpx;
}

.daily-flow {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.daily-photo {
  width: 100%;
  height: 300rpx;
  border-radius: 8rpx;
  background: #eef2f3;
}

.daily-photo.tall {
  height: 380rpx;
}
