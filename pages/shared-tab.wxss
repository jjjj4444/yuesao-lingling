page {
  min-height: 100%;
  background: #eef2f3;
  color: #14213d;
}

.tab-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 150rpx;
  box-sizing: border-box;
}

.page-hero {
  padding: 44rpx 36rpx;
  border-radius: 8rpx;
  background: linear-gradient(145deg, #102a43 0%, #1f6f78 58%, #f6c85f 100%);
  color: #ffffff;
  box-shadow: 0 22rpx 48rpx rgba(16, 42, 67, 0.2);
}

.page-kicker {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.74);
  text-transform: uppercase;
}

.page-title {
  margin-top: 16rpx;
  font-size: 52rpx;
  line-height: 1.18;
  font-weight: 800;
}

.page-subtitle {
  margin-top: 22rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.9);
}

.content-card {
  margin-top: 28rpx;
  padding: 32rpx 28rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 34rpx rgba(20, 33, 61, 0.08);
}

.content-title {
  font-size: 34rpx;
  font-weight: 800;
}

.content-item {
  margin-top: 22rpx;
  padding: 24rpx;
  border: 1rpx solid #e6ebef;
  border-radius: 8rpx;
  background: #fbfcfd;
  color: #52616f;
  font-size: 27rpx;
  line-height: 1.55;
}

.item-title {
  color: #14213d;
  font-size: 29rpx;
  line-height: 1.3;
  font-weight: 800;
}

.item-desc {
  margin-top: 10rpx;
  color: #52616f;
  font-size: 26rpx;
  line-height: 1.6;
}

.content-item.tappable {
  position: relative;
}

.item-more {
  margin-top: 12rpx;
  color: #9aa6b2;
  font-size: 22rpx;
  font-weight: 500;
}

.contact-row {
  margin-top: 18rpx;
  padding: 24rpx;
  border: 1rpx solid #e6ebef;
  border-radius: 8rpx;
  background: #fbfcfd;
}

.contact-label {
  color: #6d7f8f;
  font-size: 23rpx;
}

.contact-value {
  margin-top: 10rpx;
  color: #14213d;
  font-size: 29rpx;
  word-break: break-all;
}

.knowledge-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 99;
  background: rgba(20, 33, 61, 0.46);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.knowledge-sheet {
  position: relative;
  width: 100%;
  max-width: 640rpx;
  max-height: 74vh;
  padding: 34rpx 30rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-sizing: border-box;
  overflow-y: auto;
}

.knowledge-close-icon {
  position: absolute;
  top: 26rpx;
  right: 26rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #f4f6f8;
  color: #a8b0b8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  line-height: 1;
}

.knowledge-title {
  padding-right: 64rpx;
  color: #14213d;
  font-size: 36rpx;
  line-height: 1.25;
  font-weight: 800;
}

.knowledge-body {
  margin-top: 18rpx;
  color: #52616f;
  font-size: 27rpx;
  line-height: 1.75;
}

.knowledge-section {
  margin-top: 26rpx;
}

.knowledge-badge {
  display: inline-flex;
  padding: 8rpx 18rpx;
  border-radius: 10rpx;
  color: #ffffff;
  font-size: 25rpx;
  line-height: 1.25;
  font-weight: 800;
}

.knowledge-badge.green {
  background: #27b45f;
}

.knowledge-badge.blue {
  background: #1f8edc;
}

.knowledge-list {
  margin-top: 14rpx;
}

.knowledge-list-item {
  position: relative;
  padding-left: 28rpx;
  color: #4f5f6f;
  font-size: 27rpx;
  line-height: 1.72;
}

.knowledge-list-item::before {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 21rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #a7b0b8;
}
