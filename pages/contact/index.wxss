@import "../shared-tab.wxss";

.contact-panel {
  margin-top: 20rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #ffffff;
  border: 1rpx solid #edf0f2;
}

.contact-actions {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
  padding: 8rpx;
  background: #f7f9fa;
}

.contact-action {
  min-height: 112rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
  color: #ffffff;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
}

.contact-action + .contact-action {
  border-left: 0;
}

.wechat-action {
  background: #07c160;
}

.phone-action {
  background: #14213d;
}

.share-action {
  margin: 0;
  width: 100%;
  height: 112rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  background: #edf6f7;
  color: #1f6f78;
  line-height: 1.2;
  text-align: center;
  font-size: inherit;
}

.share-action::after {
  border: 0;
}

.share-action .action-value {
  color: #1f6f78;
}

.share-action .action-label {
  color: #6d7f8f;
}

.xhs-action {
  background: #ff2442;
}

.action-label {
  margin-bottom: 8rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 21rpx;
  line-height: 1.2;
  font-weight: 700;
}

.action-value {
  font-size: 25rpx;
  line-height: 1.2;
  font-weight: 800;
  text-align: center;
  white-space: normal;
}

.hint-text {
  margin-top: 14rpx;
  color: #7a8694;
  font-size: 23rpx;
  line-height: 1.5;
}
