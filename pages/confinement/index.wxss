page {
  min-height: 100%;
  background: #f4f6f7;
  color: #14213d;
}

.meal-page {
  height: 100vh;
  padding: 24rpx 24rpx 128rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.meal-header {
  flex: 0 0 auto;
  padding: 28rpx 28rpx;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #102a43, #1f6f78);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 14rpx 34rpx rgba(16, 42, 67, 0.18);
}

.meal-kicker {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
  text-transform: uppercase;
}

.meal-title {
  margin-top: 8rpx;
  font-size: 44rpx;
  line-height: 1.2;
  font-weight: 800;
}

.meal-subtitle {
  max-width: 480rpx;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 24rpx;
  line-height: 1.55;
}

.meal-count {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 24rpx;
}

.order-layout {
  min-height: 0;
  flex: 1;
  margin-top: 20rpx;
  display: flex;
  border-radius: 8rpx;
  overflow: hidden;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(20, 33, 61, 0.07);
}

.category-sidebar {
  width: 118rpx;
  height: 100%;
  flex: 0 0 118rpx;
  background: #eef2f3;
}

.category-item {
  position: relative;
  min-height: 86rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
  color: #52616f;
  border-bottom: 1rpx solid #dfe7ea;
  display: flex;
  align-items: center;
  justify-content: center;
}

.category-item.active {
  background: #ffffff;
  color: #14213d;
}

.category-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 18rpx;
  bottom: 18rpx;
  width: 8rpx;
  border-radius: 0 999rpx 999rpx 0;
  background: #1f6f78;
}

.category-name {
  font-size: 26rpx;
  line-height: 1.25;
  font-weight: 800;
  text-align: center;
}

.dish-panel {
  height: 100%;
  flex: 1;
  min-width: 0;
  padding: 28rpx 24rpx 34rpx;
  box-sizing: border-box;
}

.dish-section-title {
  font-size: 38rpx;
  line-height: 1.2;
  font-weight: 800;
}

.dish-section-note {
  margin-top: 8rpx;
  color: #6d7f8f;
  font-size: 24rpx;
}

.dish-card {
  margin-top: 22rpx;
  padding: 22rpx;
  border: 1rpx solid #e6ebef;
  border-radius: 8rpx;
  background: #fbfcfd;
  display: flex;
}

.dish-image {
  position: relative;
  width: 188rpx;
  height: 188rpx;
  flex: 0 0 188rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: #e9eef0;
}

.dish-photo {
  width: 100%;
  height: 100%;
  display: block;
}

.dish-info {
  min-width: 0;
  flex: 1;
  margin-left: 20rpx;
}

.dish-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dish-name {
  min-width: 0;
  flex: 1;
  font-size: 30rpx;
  line-height: 1.25;
  font-weight: 800;
}

.dish-desc {
  margin-top: 12rpx;
  color: #52616f;
  font-size: 24rpx;
  line-height: 1.5;
}

.dish-effect {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 8rpx;
  background: #fff8e6;
}

.effect-label {
  color: #9a6a00;
  font-size: 22rpx;
  font-weight: 800;
}

.effect-text {
  margin-top: 6rpx;
  color: #5f4b1a;
  font-size: 24rpx;
  line-height: 1.45;
}

.meal-knowledge-card {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 8rpx;
  background: #f7fafb;
  color: #6d7f8f;
  font-size: 22rpx;
  line-height: 1.6;
}

.meal-knowledge-link {
  display: inline-flex;
  margin: 12rpx 14rpx 0 0;
  color: #1f6f78;
  font-size: 23rpx;
  font-weight: 800;
}

.meal-knowledge-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 99;
  background: rgba(20, 33, 61, 0.42);
  display: flex;
  align-items: flex-end;
}

.meal-knowledge-sheet {
  width: 100%;
  max-height: 72vh;
  padding: 34rpx 30rpx calc(38rpx + env(safe-area-inset-bottom));
  border-radius: 18rpx 18rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
}

.meal-knowledge-title {
  color: #14213d;
  font-size: 36rpx;
  line-height: 1.25;
  font-weight: 800;
}

.meal-knowledge-body {
  margin-top: 18rpx;
  color: #52616f;
  font-size: 27rpx;
  line-height: 1.75;
}

.meal-knowledge-close {
  margin-top: 28rpx;
  height: 78rpx;
  line-height: 78rpx;
  border-radius: 8rpx;
  background: #14213d;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 800;
}

.meal-knowledge-close::after {
  border: 0;
}
